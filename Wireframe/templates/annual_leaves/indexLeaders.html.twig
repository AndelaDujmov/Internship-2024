{% extends 'base.html.twig' %}

{% block title %}Annual Leaves{% endblock %}

{% block body %}

<style>
    .example-wrapper {
        margin: 2em auto;
        max-width: 1200px;
        width: 95%;
        font-family: 'Arial', sans-serif;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 2em;
    }
    
    th, td {
        padding: 0.75em;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }
    
    th {
        background-color: #f4f4f4;
        font-size: 16px;
        color: #333;
    }
    
    tr:hover {
        background-color: rgba(100, 100, 100, 0.05);
    }
    
    .no-teams, .no-members {
        font-style: italic;
        color: #888;
        text-align: center;
        margin-top: 2em;
    }

    .addMember {
        margin-top: 1em;
        padding: 0.5em 1em;
        font-size: 14px;
        color: #fff;
        background-color: #007bff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .addMember:hover {
        background-color: #0056b3;
    }

    #anchor{
        text-decoration: none;
        color: inherit;
    }

    .table-header {
        display: flex; 
        align-items: center;
        margin-bottom: 20px; 
    }
    
    .icon-wrapper {
        display: inline-flex;
        margin-left: 930px; 
        text-decoration: none;
        color: inherit;
    }
    
    .icon {
        display: inline-flex;
        width: 40px; 
        height: 44px;
        background-color: #007bff;
        color: #fff; 
        border-radius: 50%;
        text-align: center; 
        line-height: 44px; 
        font-size: 50px; 
        padding-left: 8px;
        font-weight: bold; 
        cursor: pointer; 
    }
    
    .icon:hover {
        background-color: #0056b3; 
    }

    .status-accepted {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 4px;
        color: white;
        background-color: green;
    }
    
    .status-rejected {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 4px;
        color: white;
        background-color: red;
    }
    
    .status-pending {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 4px;
        color: white;
        background-color: orange;
    }    
</style>

<div class="example-wrapper">
    <div class="table-header">
        <h1>Annual Leaves</h1>
    </div>
    {% if requests|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Team</th>
                    <th>By</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for request in requests %}
                    {% for vacation in request %}
                        <tr>
                            <td>
                                {{ vacation.getStart()|date('d-m-Y') }} - {{ vacation.getEnd()|date('d-m-Y') }}
                            </td>
                            <td>{{ vacation.getReason() }}</td>
                            <td>
                                <span class="{% if vacation.getStatus() == 'Approved' %} status-accepted {% elseif vacation.getStatus() == 'Rejected' %} status-rejected {% else %} status-pending {% endif %}">
                                    {{ vacation.getStatus() }}
                                </span>
                            </td>   
                            <td>{{ vacation.getWorker().getTeam().getName() }}</td>
                            <td>{{ vacation.getWorker().getUsername() }}</td>
                            <td> <a  id="anchor" href="{{ path('app_annual_leaves_check', {'requestId': vacation.getId() }) }}"><i class="info-icon" title="More information">i</i></a></td>
                        </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    
    {% else %}
        <p class="no-teams">No teams available</p>
    {% endif %}
</div>

{% endblock %}