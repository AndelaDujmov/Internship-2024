{# templates/annual_leaves/create.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}TeamController{% endblock %}

{% block body %}
    <style>
        .form-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #f9f9f9;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 10px;
            font-size: 1.1em;
            font-weight: bold;
        }
        .form-group input[type="date"] {
            width: 100%;
            padding: 12px;
            font-size: 1em;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box;
            height: 48px;
        }
        .form-group button {
            padding: 12px 20px;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
        }
        .form-group button:hover {
            background-color: #0056b3;
        }
    </style>

    <div class="form-container">
        {{ form_errors(form) }}

        {{ form_start(form, { 'attr': { 'class': 'form-group' } }) }}
        <p>You have in total {{ vacationDays  }} days left</p>
            {{ form_row(form.start, { 'attr': { 'class': 'form-group' } }) }}
            {{ form_row(form.end, { 'attr': { 'class': 'form-group' } }) }}
            {{ form_row(form.reason, { 'attr': { 'class': 'form-group' } }) }}

            <button type="submit" class="btn">Add</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
